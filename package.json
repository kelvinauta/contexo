{
  "name": "contexo-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace and release tooling for the ConteXo CLI.",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:binary": "bun run build/bunbuild.ts",
    "build:release": "bun run build/release-assets.ts",
    "start": "bun src/index.ts",
    "test": "bun run test:high",
    "test:smoke": "bun run scripts/test-suite.ts smoke",
    "test:contracts": "bun run scripts/test-suite.ts contracts",
    "test:compat": "bun run scripts/test-suite.ts compat",
    "test:low": "bun run scripts/test-suite.ts low",
    "test:medium": "bun run scripts/test-suite.ts medium",
    "test:high": "bun run scripts/test-suite.ts high",
    "test:all": "bun run scripts/test-suite.ts all",
    "test:list": "bun run scripts/test-suite.ts --list"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/fs-extra": "^11.0.4",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.2.3",
    "cleye": "^2.2.1",
    "fs-extra": "^11.3.0",
    "ignore": "^7.0.5",
    "isbinaryfile": "^5.0.4",
    "js-tiktoken": "^1.0.21",
    "mustache": "^4.2.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3",
    "yocto-spinner": "^1.1.0"
  }
}
